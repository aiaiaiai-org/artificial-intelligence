{
  "name": "@aiaiaiai/contracts",
  "version": "0.2.0",
  "description": "Host-side mirror of the aiaiaiai AI foundation wire contract 0.2.0. No runtime dependencies.",
  "keywords": [
    "aiaiaiai",
    "contract",
    "canonical-json",
    "wire-format",
    "typescript"
  ],
  "homepage": "https://github.com/aiaiaiai-org/artificial-intelligence/blob/master/packages/aiai-contracts#readme",
  "bugs": {
    "url": "https://github.com/aiaiaiai-org/artificial-intelligence/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiaiaiai-org/artificial-intelligence.git",
    "directory": "packages/aiai-contracts"
  },
  "license": "Apache-2.0",
  "author": "aiaiaiai",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
