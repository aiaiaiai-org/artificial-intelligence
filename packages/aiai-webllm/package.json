{
  "name": "@aiaiaiai/webllm",
  "version": "0.1.0",
  "description": "Explicit browser-local WebLLM lifecycle adapter for aiaiaiai runtimes.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.84"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
